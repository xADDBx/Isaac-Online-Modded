<Project Sdk="Microsoft.NET.Sdk">



	<PropertyGroup>

		<OutputType>WinExe</OutputType>

		<Version>1.7.0</Version>

		<TargetFramework>net10.0</TargetFramework>

		<Nullable>enable</Nullable>

		<ImplicitUsings>enable</ImplicitUsings>

		<LangVersion>latest</LangVersion>

		<PublishSingleFile>true</PublishSingleFile>

		<SelfContained>true</SelfContained>

		<PublishTrimmed>true</PublishTrimmed>

		<EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>

		<IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>

		<BuiltInComInteropSupport>false</BuiltInComInteropSupport>

		<AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>

		<AnalysisLevel>preview</AnalysisLevel>

		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>

		<DebugType>embedded</DebugType>

		<ApplicationIcon>Icon.ico</ApplicationIcon>

	</PropertyGroup>



	<ItemGroup>

		<AvaloniaResource Include="Icon.ico" />

	</ItemGroup>

	<ItemGroup>

		<PackageReference Include="Avalonia" Version="12.1.4" />

		<PackageReference Include="Avalonia.Desktop" Version="12.1.4" />

		<PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />

		<PackageReference Include="GameFinder.StoreHandlers.EGS" Version="4.9.0" />

		<PackageReference Include="GameFinder.StoreHandlers.GOG" Version="4.9.0" />

		<PackageReference Include="GameFinder.StoreHandlers.Steam" Version="4.9.0" />
		<PackageReference Include="GameFinder.Wine" Version="4.9.0" />

	</ItemGroup>

	<!-- SkiaSharp and HarfBuzzSharp ship native .pdb files, which single file publishing leaves next to the exe -->
	<Target Name="RemovePublishedPdbs" AfterTargets="ComputeResolvedFilesToPublishList">
		<ItemGroup>
			<ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Extension)' == '.pdb'" />
		</ItemGroup>
	</Target>



</Project>

